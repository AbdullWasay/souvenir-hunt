MONGODB_URI=mongodb://localhost:27017/souvenirhunt

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=use-a-long-random-string

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Public URL for checkout redirects and play links
APP_URL=http://localhost:5173

# Optional email sending (Resend)
RESEND_API_KEY=re_...
FROM_EMAIL=noreply@yourdomain.com

# Optional email sending (Mailtrap Email Sending — not the sandbox/testing inbox)
# Token: Sending Domains → your domain → Integration → API
MAILTRAP_API_TOKEN=your_sending_api_token
# Must use an address on a domain you verified in Mailtrap (no quotes)
MAILTRAP_SENDER_EMAIL=no-reply@yourdomain.com
